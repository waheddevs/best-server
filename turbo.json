{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["eslint.config.mjs", "tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "generate": {
      "dependsOn": ["^build"],
      "outputs": ["src/generated/**"]
    },
    "lint": {
      "dependsOn": ["^build", "^lint"]
    },
    "test": {
      "dependsOn": ["^build", "^test"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "POSTGRES_DB",
        "POSTGRES_HOST",
        "POSTGRES_PASSWORD",
        "POSTGRES_PORT",
        "POSTGRES_USER",
        "REDIS_HOST",
        "REDIS_PORT",
        "S3_ACCESS_KEY_ID",
        "S3_BUCKET",
        "S3_DOWNLOAD_URL_TTL_SECONDS",
        "S3_ENDPOINT",
        "S3_FORCE_PATH_STYLE",
        "S3_MAX_UPLOAD_BYTES",
        "S3_REGION",
        "S3_SECRET_ACCESS_KEY",
        "S3_UPLOAD_URL_TTL_SECONDS"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"]
    },
    "validate": {
      "dependsOn": ["^build"]
    },
    "@best/database#build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**"]
    },
    "@best/database#lint": {
      "dependsOn": ["^build", "^lint", "generate"]
    },
    "@best/database#typecheck": {
      "dependsOn": ["^build", "^typecheck", "generate"]
    }
  }
}
