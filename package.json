{
  "name": "best-server",
  "version": "0.1.0",
  "private": true,
  "description": "BEST LC backend monorepo",
  "license": "UNLICENSED",
  "packageManager": "yarn@4.14.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependenciesMeta": {
    "@prisma/engines": {
      "built": true
    },
    "prisma": {
      "built": true
    }
  },
  "scripts": {
    "build": "turbo run build",
    "database:generate": "turbo run generate --filter=@best/database",
    "database:migrate:deploy": "yarn workspace @best/database migrate:deploy",
    "database:migrate:status": "yarn workspace @best/database migrate:status",
    "database:test:integration": "turbo run test:integration --filter=@best/database",
    "database:validate": "turbo run validate --filter=@best/database",
    "dev": "turbo run dev --parallel",
    "dev:api": "turbo run dev --filter=@best/api",
    "dev:import": "turbo run dev --filter=@best/import-worker",
    "dev:scoring": "turbo run dev --filter=@best/scoring-worker",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:config": "docker compose --env-file .env -f infrastructure/docker/compose.yaml config",
    "infra:down": "docker compose --env-file .env -f infrastructure/docker/compose.yaml down",
    "infra:logs": "docker compose --env-file .env -f infrastructure/docker/compose.yaml logs --follow",
    "infra:up": "docker compose --env-file .env -f infrastructure/docker/compose.yaml up --detach --wait",
    "api:test:integration": "turbo run test:integration --filter=@best/api",
    "scoring:test:integration": "turbo run test:integration --filter=@best/scoring-worker",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^17.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "turbo": "^2.5.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
