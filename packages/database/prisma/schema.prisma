generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  DELETED
}

enum AuthProvider {
  GOOGLE
  FACEBOOK
  APPLE
}

enum ContentStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum TestVersionStatus {
  DRAFT
  PUBLISHED
}

enum TestSkill {
  LISTENING
  READING
  WRITING
  SPEAKING
}

enum IeltsModule {
  ACADEMIC
  GENERAL_TRAINING
}

enum QuestionKind {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  SHORT_TEXT
  TRUE_FALSE_NOT_GIVEN
  YES_NO_NOT_GIVEN
  MATCHING
  LONG_TEXT
  AUDIO_RESPONSE
}

enum TestSectionBlockKind {
  HEADING
  RICH_TEXT
  IMAGE
  TABLE
  AUDIO
  QUESTION_GROUP
}

enum Language {
  UZ
  RU
  EN
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  REVIEW_REQUIRED
  SCORED
}

enum AttemptSubmissionReason {
  MANUAL
  DURATION_EXPIRED
  AVAILABILITY_ENDED
}

enum LibraryVisibility {
  ALL_GROUPS
  SELECTED_GROUPS
}

enum MediaType {
  PDF
  IMAGE
  AUDIO
  VIDEO
  ARCHIVE
}

enum MediaObjectStatus {
  PENDING_UPLOAD
  VERIFYING
  READY
  REJECTED
}

enum MediaObjectSource {
  USER_UPLOAD
  TELEGRAM_IMPORT
  SYSTEM_GENERATED
}

enum MediaVisibility {
  OWNER_ONLY
  DOMAIN_AUTHORIZED
}

enum MediaMalwareStatus {
  PENDING
  CLEAN
  INFECTED
}

enum ImportRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ImportExtractionMethod {
  EMBEDDED_TEXT
  OCR
}

enum ImportExtractionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ImportRightsStatus {
  REVIEW_REQUIRED
  APPROVED
  REJECTED
}

enum VocabularyDraftStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
}

enum PaymentMethod {
  CASH
  CARD
}

enum FinanceAdjustmentKind {
  CREDIT
  DEBIT
  REVERSAL
}

enum OutboxEventType {
  ATTEMPT_SUBMITTED
}

enum TransferRequestStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

enum GroupMembershipStatus {
  ACTIVE
  PAUSED
}

enum LessonStatus {
  DRAFT
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum LessonMaterialKind {
  MATERIAL
  TASK
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SubmissionStatus {
  SUBMITTED
  REVIEWED
  RETURNED
}

enum PublicContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum IntakeStatus {
  NEW
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum TeacherTaskStatus {
  OPEN
  COMPLETED
}

enum TeacherTaskKind {
  FOLLOW_UP
  PREPARATION
  ADMINISTRATIVE
}

enum PublicCourseCategory {
  ENGLISH
  EXAM
  LANGUAGE
}

enum GroupCategory {
  IELTS
  CEFR
  GENERAL_ENGLISH
}

enum PublicCourseAccent {
  BLUE
  TURQUOISE
  YELLOW
}

enum PublicCourseContentKind {
  OVERVIEW
  HIGHLIGHT
  OUTCOME
  CURRICULUM
}

enum PublicEventTimelineStatus {
  UPCOMING
  PAST
}

model User {
  id                        String                     @id @default(uuid()) @db.Uuid
  role                      UserRole
  status                    UserStatus                 @default(ACTIVE)
  displayName               String                     @map("display_name") @db.VarChar(160)
  firstName                 String?                    @map("first_name") @db.VarChar(80)
  lastName                  String?                    @map("last_name") @db.VarChar(80)
  email                     String?                    @unique @db.VarChar(320)
  emailVerifiedAt           DateTime?                  @map("email_verified_at") @db.Timestamptz(3)
  credentialPasswordHash    String?                    @map("credential_password_hash") @db.VarChar(255)
  phone                     String?                    @db.VarChar(32)
  preferredLanguage         Language                   @default(UZ) @map("preferred_language")
  teacherSubject            String?                    @map("teacher_subject") @db.VarChar(160)
  branchName                String?                    @map("branch_name") @db.VarChar(160)
  avatarMediaObjectId       String?                    @unique @map("avatar_media_object_id") @db.Uuid
  createdAt                 DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  authAccounts              AuthAccount[]
  credentialLoginChallenges CredentialLoginChallenge[]
  credentialSessions        CredentialSession[]
  ownedGroups               Group[]                    @relation("GroupTeacher")
  groupMemberships          GroupMembership[]          @relation("StudentMembership")
  createdTestCategories     TestCategory[]             @relation("TestCategoryCreator")
  createdTestPapers         TestPaper[]                @relation("TestPaperCreator")
  attempts                  Attempt[]                  @relation("StudentAttempts")
  reviewedAttempts          AttemptReview[]            @relation("AttemptReviewer")
  receivedAttemptGrants     AttemptGrant[]             @relation("AttemptGrantStudent")
  issuedAttemptGrants       AttemptGrant[]             @relation("AttemptGrantActor")
  createdLibraryCategories  LibraryCategory[]          @relation("LibraryCategoryCreator")
  ownedLibraryItems         LibraryItem[]              @relation("LibraryItemOwner")
  createdMediaObjects       MediaObject[]              @relation("MediaObjectCreator")
  avatarMediaObject         MediaObject?               @relation("UserAvatar", fields: [avatarMediaObjectId], references: [id], onDelete: SetNull)
  tuitionOverrides          StudentTuitionOverride[]   @relation("TuitionOverrideStudent")
  createdTuitionOverrides   StudentTuitionOverride[]   @relation("TuitionOverrideActor")
  tuitionCharges            TuitionCharge[]            @relation("TuitionChargeStudent")
  payments                  Payment[]                  @relation("PaymentStudent")
  recordedPayments          Payment[]                  @relation("PaymentActor")
  financeAdjustments        FinanceAdjustment[]        @relation("FinanceAdjustmentStudent")
  recordedAdjustments       FinanceAdjustment[]        @relation("FinanceAdjustmentActor")
  createdTuitionRates       GroupTuitionRate[]         @relation("TuitionRateActor")
  auditLogs                 AuditLog[]                 @relation("AuditActor")
  requestedTransfers        GroupTransferRequest[]     @relation("TransferRequester")
  reviewedTransfers         GroupTransferRequest[]     @relation("TransferReviewer")
  transferRequests          GroupTransferRequest[]     @relation("TransferStudent")
  lessonAttendances         LessonAttendance[]         @relation("AttendanceStudent")
  assignmentSubmissions     AssignmentSubmission[]     @relation("SubmissionStudent")
  reviewedSubmissions       AssignmentSubmission[]     @relation("SubmissionReviewer")
  createdLessons            Lesson[]                   @relation("LessonCreator")
  createdMaterials          LessonMaterial[]           @relation("MaterialCreator")
  createdAssignments        Assignment[]               @relation("AssignmentCreator")
  teacherTasks              TeacherTask[]              @relation("TeacherTaskOwner")
  notifications             Notification[]
  practiceBookmarks         PracticeBookmark[]
  teacherFinanceSnapshots   TeacherFinanceSnapshot[]   @relation("TeacherFinanceSnapshotOwner")

  @@index([role, status])
  @@map("users")
}

model CredentialLoginChallenge {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  codeHash          String    @map("code_hash") @db.VarChar(64)
  attempts          Int       @default(0)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  resendAvailableAt DateTime  @map("resend_available_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  usedAt            DateTime? @map("used_at") @db.Timestamptz(3)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt, expiresAt])
  @@map("credential_login_challenges")
}

model CredentialLoginThrottle {
  keyHash     String    @id @map("key_hash") @db.VarChar(64)
  failures    Int       @default(0)
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("credential_login_throttles")
}

model CredentialSession {
  id            String                   @id @default(uuid()) @db.Uuid
  userId        String                   @map("user_id") @db.Uuid
  expiresAt     DateTime                 @map("expires_at") @db.Timestamptz(3)
  idleExpiresAt DateTime                 @map("idle_expires_at") @db.Timestamptz(3)
  lastUsedAt    DateTime                 @map("last_used_at") @db.Timestamptz(3)
  revokedAt     DateTime?                @map("revoked_at") @db.Timestamptz(3)
  revokeReason  String?                  @map("revoke_reason") @db.VarChar(80)
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens CredentialRefreshToken[]

  @@index([userId, revokedAt, expiresAt])
  @@index([idleExpiresAt, revokedAt])
  @@map("credential_sessions")
}

model CredentialRefreshToken {
  id         String            @id @db.Uuid
  sessionId  String            @map("session_id") @db.Uuid
  tokenHash  String            @unique @map("token_hash") @db.VarChar(64)
  consumedAt DateTime?         @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  session    CredentialSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, consumedAt])
  @@map("credential_refresh_tokens")
}

model AuthAccount {
  id                      String       @id @default(uuid()) @db.Uuid
  userId                  String       @map("user_id") @db.Uuid
  provider                AuthProvider
  providerAccountId       String       @map("provider_account_id") @db.VarChar(255)
  providerEmail           String?      @map("provider_email") @db.VarChar(320)
  providerEmailVerifiedAt DateTime?    @map("provider_email_verified_at") @db.Timestamptz(3)
  createdAt               DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  lastAuthenticatedAt     DateTime     @default(now()) @map("last_authenticated_at") @db.Timestamptz(3)
  user                    User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@map("auth_accounts")
}

model Group {
  id                 String                   @id @default(uuid()) @db.Uuid
  teacherId          String                   @map("teacher_id") @db.Uuid
  name               String                   @db.VarChar(160)
  category           GroupCategory?
  slug               String                   @unique @db.VarChar(160)
  room               String?                  @db.VarChar(80)
  scheduleDays       Int[]                    @default([]) @map("schedule_days") @db.SmallInt
  startsAtMinutes    Int?                     @map("starts_at_minutes") @db.SmallInt
  endsAtMinutes      Int?                     @map("ends_at_minutes") @db.SmallInt
  timeZone           String                   @default("Asia/Tashkent") @map("time_zone") @db.VarChar(64)
  status             ContentStatus            @default(ACTIVE)
  paymentDeadlineDay Int?                     @map("payment_deadline_day")
  archivedAt         DateTime?                @map("archived_at") @db.Timestamptz(3)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  teacher            User                     @relation("GroupTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  memberships        GroupMembership[]
  tests              Test[]
  testPapers         TestPaper[]
  testImportSources  TestImportSource[]
  libraryAccesses    LibraryGroupAccess[]
  tuitionRates       GroupTuitionRate[]
  tuitionOverrides   StudentTuitionOverride[]
  outgoingTransfers  GroupTransferRequest[]   @relation("TransferFromGroup")
  incomingTransfers  GroupTransferRequest[]   @relation("TransferToGroup")
  lessons            Lesson[]
  lessonMaterials    LessonMaterial[]
  assignments        Assignment[]
  teacherTasks       TeacherTask[]

  @@unique([teacherId, name])
  @@index([status])
  @@map("groups")
}

model GroupMembership {
  id                  String                @id @default(uuid()) @db.Uuid
  groupId             String                @map("group_id") @db.Uuid
  studentId           String                @map("student_id") @db.Uuid
  participationStatus GroupMembershipStatus @default(ACTIVE) @map("participation_status")
  startedAt           DateTime              @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt             DateTime?             @map("ended_at") @db.Timestamptz(3)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  group               Group                 @relation(fields: [groupId], references: [id], onDelete: Restrict)
  student             User                  @relation("StudentMembership", fields: [studentId], references: [id], onDelete: Restrict)
  attempts            Attempt[]
  tuitionCharges      TuitionCharge[]
  attendances         LessonAttendance[]

  @@index([groupId, endedAt])
  @@index([groupId, participationStatus, endedAt])
  @@index([studentId, startedAt])
  @@map("group_memberships")
}

model GroupTransferRequest {
  id            String                @id @default(uuid()) @db.Uuid
  studentId     String                @map("student_id") @db.Uuid
  fromGroupId   String                @map("from_group_id") @db.Uuid
  toGroupId     String                @map("to_group_id") @db.Uuid
  requestedById String                @map("requested_by_id") @db.Uuid
  reviewedById  String?               @map("reviewed_by_id") @db.Uuid
  status        TransferRequestStatus @default(PENDING)
  reason        String                @db.Text
  reviewNote    String?               @map("review_note") @db.Text
  reviewedAt    DateTime?             @map("reviewed_at") @db.Timestamptz(3)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  student       User                  @relation("TransferStudent", fields: [studentId], references: [id], onDelete: Restrict)
  fromGroup     Group                 @relation("TransferFromGroup", fields: [fromGroupId], references: [id], onDelete: Restrict)
  toGroup       Group                 @relation("TransferToGroup", fields: [toGroupId], references: [id], onDelete: Restrict)
  requestedBy   User                  @relation("TransferRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy    User?                 @relation("TransferReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([requestedById, status, createdAt])
  @@index([toGroupId, status, createdAt])
  @@index([studentId, createdAt])
  @@map("group_transfer_requests")
}

model TestCategory {
  id        String   @id @default(uuid()) @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  creator   User     @relation("TestCategoryCreator", fields: [teacherId], references: [id], onDelete: Restrict)
  tests     Test[]

  @@unique([teacherId, name])
  @@map("test_categories")
}

model TestPaper {
  id             String             @id @default(uuid()) @db.Uuid
  groupId        String             @map("group_id") @db.Uuid
  createdById    String             @map("created_by_id") @db.Uuid
  practiceNumber Int                @map("practice_number")
  ieltsModule    IeltsModule        @default(ACADEMIC) @map("ielts_module")
  slug           String             @db.VarChar(160)
  academicYear   Int                @map("academic_year")
  title          String             @db.VarChar(240)
  sourceLabel    String             @map("source_label") @db.Text
  status         ContentStatus      @default(ACTIVE)
  archivedAt     DateTime?          @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  group          Group              @relation(fields: [groupId], references: [id], onDelete: Restrict)
  createdBy      User               @relation("TestPaperCreator", fields: [createdById], references: [id], onDelete: Restrict)
  tests          Test[]
  bookmarks      PracticeBookmark[]

  @@unique([groupId, slug])
  @@unique([groupId, practiceNumber])
  @@index([groupId, academicYear, status])
  @@map("test_papers")
}

model Test {
  id         String         @id @default(uuid()) @db.Uuid
  groupId    String         @map("group_id") @db.Uuid
  categoryId String         @map("category_id") @db.Uuid
  paperId    String?        @map("paper_id") @db.Uuid
  skill      TestSkill?
  status     ContentStatus  @default(ACTIVE)
  archivedAt DateTime?      @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  group      Group          @relation(fields: [groupId], references: [id], onDelete: Restrict)
  category   TestCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  paper      TestPaper?     @relation(fields: [paperId], references: [id], onDelete: Restrict)
  versions   TestVersion[]
  grants     AttemptGrant[]

  @@unique([paperId, skill])
  @@index([groupId, status])
  @@index([categoryId])
  @@index([paperId])
  @@map("tests")
}

model TestVersion {
  id                   String            @id @default(uuid()) @db.Uuid
  testId               String            @map("test_id") @db.Uuid
  version              Int
  status               TestVersionStatus @default(DRAFT)
  primaryLanguage      Language          @map("primary_language")
  availabilityStartsAt DateTime?         @map("availability_starts_at") @db.Timestamptz(3)
  availabilityEndsAt   DateTime?         @map("availability_ends_at") @db.Timestamptz(3)
  durationMinutes      Int?              @map("duration_minutes")
  attemptLimit         Int               @default(1) @map("attempt_limit")
  passingPercentage    Int               @default(60) @map("passing_percentage")
  scoringRuleVersion   String            @default("single-choice-v1") @map("scoring_rule_version") @db.VarChar(80)
  publishedAt          DateTime?         @map("published_at") @db.Timestamptz(3)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  test                 Test              @relation(fields: [testId], references: [id], onDelete: Restrict)
  translations         TestTranslation[]
  questions            Question[]
  sections             TestSection[]
  attempts             Attempt[]
  importSource         TestImportSource?

  @@unique([testId, version])
  @@index([status, availabilityStartsAt, availabilityEndsAt])
  @@map("test_versions")
}

model TestImportSource {
  id            String      @id @default(uuid()) @db.Uuid
  sourceSystem  String      @map("source_system") @db.VarChar(80)
  externalId    String      @map("external_id") @db.VarChar(240)
  sourcePath    String      @map("source_path") @db.Text
  sourceSha256  String      @map("source_sha256") @db.Char(64)
  targetGroupId String      @map("target_group_id") @db.Uuid
  testVersionId String      @unique @map("test_version_id") @db.Uuid
  importedAt    DateTime    @default(now()) @map("imported_at") @db.Timestamptz(3)
  targetGroup   Group       @relation(fields: [targetGroupId], references: [id], onDelete: Restrict)
  testVersion   TestVersion @relation(fields: [testVersionId], references: [id], onDelete: Restrict)

  @@unique([sourceSystem, externalId, targetGroupId])
  @@index([targetGroupId, importedAt])
  @@map("test_import_sources")
}

model TestSection {
  id                 String                   @id @default(uuid()) @db.Uuid
  testVersionId      String                   @map("test_version_id") @db.Uuid
  position           Int
  mediaObjectId      String?                  @map("media_object_id") @db.Uuid
  suggestedMinutes   Int?                     @map("suggested_minutes")
  minimumWords       Int?                     @map("minimum_words")
  preparationSeconds Int?                     @map("preparation_seconds")
  responseSeconds    Int?                     @map("response_seconds")
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  testVersion        TestVersion              @relation(fields: [testVersionId], references: [id], onDelete: Cascade)
  mediaObject        MediaObject?             @relation("TestSectionMedia", fields: [mediaObjectId], references: [id], onDelete: Restrict)
  translations       TestSectionTranslation[]
  blocks             TestSectionBlock[]
  questions          Question[]
  evidence           QuestionEvidence[]
  attemptNotes       AttemptSectionNote[]

  @@unique([testVersionId, position])
  @@index([mediaObjectId])
  @@map("test_sections")
}

model TestSectionTranslation {
  id            String      @id @default(uuid()) @db.Uuid
  testSectionId String      @map("test_section_id") @db.Uuid
  language      Language
  title         String      @db.VarChar(240)
  instructions  String      @db.Text
  content       String?     @db.Text
  testSection   TestSection @relation(fields: [testSectionId], references: [id], onDelete: Cascade)

  @@unique([testSectionId, language])
  @@map("test_section_translations")
}

model TestSectionBlock {
  id            String                        @id @default(uuid()) @db.Uuid
  testSectionId String                        @map("test_section_id") @db.Uuid
  position      Int
  kind          TestSectionBlockKind
  mediaObjectId String?                       @map("media_object_id") @db.Uuid
  headingLevel  Int?                          @map("heading_level")
  tablePayload  Json?                         @map("table_payload") @db.JsonB
  createdAt     DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(3)
  testSection   TestSection                   @relation(fields: [testSectionId], references: [id], onDelete: Cascade)
  mediaObject   MediaObject?                  @relation("TestSectionBlockMedia", fields: [mediaObjectId], references: [id], onDelete: Restrict)
  translations  TestSectionBlockTranslation[]
  questions     TestSectionBlockQuestion[]

  @@unique([testSectionId, position])
  @@index([mediaObjectId])
  @@map("test_section_blocks")
}

model TestSectionBlockTranslation {
  id                 String           @id @default(uuid()) @db.Uuid
  testSectionBlockId String           @map("test_section_block_id") @db.Uuid
  language           Language
  text               String?          @db.Text
  altText            String?          @map("alt_text") @db.Text
  caption            String?          @db.Text
  testSectionBlock   TestSectionBlock @relation(fields: [testSectionBlockId], references: [id], onDelete: Cascade)

  @@unique([testSectionBlockId, language])
  @@map("test_section_block_translations")
}

model TestSectionBlockQuestion {
  testSectionBlockId String           @map("test_section_block_id") @db.Uuid
  questionId         String           @unique @map("question_id") @db.Uuid
  position           Int
  testSectionBlock   TestSectionBlock @relation(fields: [testSectionBlockId], references: [id], onDelete: Cascade)
  question           Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([testSectionBlockId, questionId])
  @@unique([testSectionBlockId, position])
  @@map("test_section_block_questions")
}

model TestTranslation {
  id            String      @id @default(uuid()) @db.Uuid
  testVersionId String      @map("test_version_id") @db.Uuid
  language      Language
  title         String      @db.VarChar(240)
  description   String?     @db.Text
  testVersion   TestVersion @relation(fields: [testVersionId], references: [id], onDelete: Cascade)

  @@unique([testVersionId, language])
  @@map("test_translations")
}

model Question {
  id              String                     @id @default(uuid()) @db.Uuid
  testVersionId   String                     @map("test_version_id") @db.Uuid
  sectionId       String?                    @map("section_id") @db.Uuid
  kind            QuestionKind               @default(SINGLE_CHOICE)
  answerLimit     Int?                       @map("answer_limit")
  maxSelections   Int?                       @map("max_selections")
  position        Int
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  testVersion     TestVersion                @relation(fields: [testVersionId], references: [id], onDelete: Cascade)
  section         TestSection?               @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  translations    QuestionTranslation[]
  options         AnswerOption[]
  answers         AttemptAnswer[]
