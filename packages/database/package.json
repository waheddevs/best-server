{
  "name": "@best/database",
  "version": "0.1.0",
  "private": true,
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "prisma generate",
    "lint": "eslint \"{src,test}/**/*.ts\" \"prisma.config.ts\"",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "import:teacher-roster": "node --experimental-strip-types prisma/import-teacher-group-roster.ts",
    "import:teacher-payments": "node --experimental-strip-types prisma/import-teacher-payment-fixtures.ts",
    "seed:teacher-lessons": "node --experimental-strip-types prisma/seed-teacher-lesson-plans.ts",
    "seed:teacher-finance": "node --experimental-strip-types prisma/seed-teacher-finance.ts",
    "seed:teacher-notifications": "node --experimental-strip-types prisma/seed-teacher-notifications.ts",
    "seed:academic-test": "node --experimental-strip-types prisma/seed-best-lc-academic-test.ts",
    "seed:public": "node --experimental-strip-types prisma/seed-public-content.ts",
    "import:easyielts-tests": "node --experimental-strip-types prisma/import-easyielts-tests.ts",
    "test": "tsc -p tsconfig.integration.json && node --test ../../.tmp/database-integration/test/easyielts-import.spec.js",
    "test:integration": "tsc -p tsconfig.integration.json && node --test --test-concurrency=1 ../../.tmp/database-integration/test/database.integration.spec.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "validate": "prisma validate"
  },
  "dependencies": {
    "@best/config": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "8.18.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "prisma": "7.10.0"
  }
}
