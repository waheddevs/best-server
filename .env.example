# Application
NODE_ENV=development
API_PORT=4000

# Bearer access tokens. Replace the development-only example secret everywhere.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_ISSUER=best-api
JWT_ACCESS_AUDIENCE=best-clients
JWT_ACCESS_TTL_SECONDS=3600

# Login throttling. Keep the HMAC key distinct from JWT keys.
AUTH_LOGIN_HASH_SECRET=replace-with-a-different-32-character-secret

# Local PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=best
POSTGRES_USER=best
POSTGRES_PASSWORD=replace-with-a-local-password
# Optional override for Prisma CLI and deployments. When omitted at runtime,
# the typed config package derives the same URL from the values above.
DATABASE_URL=postgresql://best:replace-with-a-local-password@127.0.0.1:5432/best?schema=public

# Local Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Local S3-compatible object storage (SeaweedFS in Docker)
S3_ENDPOINT=http://127.0.0.1:8333
# Optional browser-reachable signing endpoint; internal storage calls keep S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=best-private
S3_ACCESS_KEY_ID=best-local-storage
S3_SECRET_ACCESS_KEY=replace-with-a-local-storage-secret
S3_FORCE_PATH_STYLE=true
S3_UPLOAD_URL_TTL_SECONDS=300
S3_DOWNLOAD_URL_TTL_SECONDS=300
S3_MAX_UPLOAD_BYTES=52428800

# Local malware scanner (official ClamAV container, loopback-only TCP)
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_CONNECT_TIMEOUT_MS=5000
CLAMAV_SCAN_TIMEOUT_MS=60000

# Local in-process text-to-speech (kokoro-js downloads and caches the model)
TTS_DEFAULT_VOICE=bf_emma
TTS_MODEL_ID=onnx-community/Kokoro-82M-v1.0-ONNX
TTS_MODEL_DTYPE=q8
TTS_MAX_TRANSCRIPT_CHARACTERS=8000
# Per API process; timeout includes time waiting in the local queue.
TTS_MAX_QUEUED_GENERATIONS=2
TTS_GENERATION_TIMEOUT_MS=120000

# Teacher-only AI chat configuration. Never put these in NEXT_PUBLIC_*.
# Activation requires a reviewed free/private endpoint and explicit pilot/privacy settings.
TEACHER_AI_CHAT_ENABLED=false
OPENROUTER_API_KEY=
# Pin a reviewed :free model and provider slug; no paid variants or auto router.
AI_CHAT_MODEL=
AI_CHAT_PROVIDER_ENDPOINT=
AI_CHAT_DAILY_BUDGET_USD=0
AI_CHAT_DAILY_REQUEST_LIMIT=40
AI_CHAT_TEACHER_DAILY_REQUEST_LIMIT=10
AI_CHAT_REQUESTS_PER_MINUTE=10
AI_CHAT_CONCURRENCY=1
AI_CHAT_MAX_INPUT_CHARACTERS=4000
AI_CHAT_MAX_CONTEXT_TOKENS=4096
AI_CHAT_MAX_OUTPUT_TOKENS=1024
AI_CHAT_TIMEOUT_MS=60000
# Explicit activation decisions; never infer consent or include all Teachers.
AI_CHAT_PILOT_TEACHER_IDS=
AI_CHAT_RETENTION_DAYS=
AI_CHAT_PROCESSING_NOTICE_VERSION=
AI_CHAT_PRIVACY_REVIEWED=false
