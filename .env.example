# Application
NODE_ENV=development
API_PORT=4000

# Bearer access tokens. Replace the development-only example secret everywhere.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_ISSUER=best-api
JWT_ACCESS_AUDIENCE=best-clients
JWT_ACCESS_TTL_SECONDS=3600

# Email-code verification is deferred. Enable only after real SMTP is configured.
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# Credential login challenges. Keep the OTP HMAC key distinct from JWT keys.
AUTH_OTP_HASH_SECRET=replace-with-a-different-32-character-secret

# Local development sends to the loopback-only Mailpit inbox from Compose.
# Set smtp when enabling email verification and configure a real provider.
AUTH_EMAIL_DELIVERY_MODE=disabled
AUTH_SMTP_HOST=127.0.0.1
AUTH_SMTP_PORT=1025
AUTH_SMTP_SECURE=false
AUTH_EMAIL_FROM=BEST LC <no-reply@best-lc.example>
# AUTH_SMTP_USER=
# AUTH_SMTP_PASSWORD=

# One-time local/deployment Admin bootstrap. Set these only while running
# `yarn workspace @best/api bootstrap:admin`, then remove the password again.
# BOOTSTRAP_ADMIN_NAME=BEST Administrator
# BOOTSTRAP_ADMIN_EMAIL=admin@best-lc.example
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-16-characters

# Local PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=best
POSTGRES_USER=best
POSTGRES_PASSWORD=replace-with-a-local-password
# Optional override for Prisma CLI and deployments. When omitted at runtime,
# the typed config package derives the same URL from the values above.
DATABASE_URL=postgresql://best:replace-with-a-local-password@127.0.0.1:5432/best?schema=public

# Local Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Local S3-compatible object storage (SeaweedFS in Docker)
S3_ENDPOINT=http://127.0.0.1:8333
# Optional browser-reachable signing endpoint; internal storage calls keep S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=best-private
S3_ACCESS_KEY_ID=best-local-storage
S3_SECRET_ACCESS_KEY=replace-with-a-local-storage-secret
S3_FORCE_PATH_STYLE=true
S3_UPLOAD_URL_TTL_SECONDS=300
S3_DOWNLOAD_URL_TTL_SECONDS=300
S3_MAX_UPLOAD_BYTES=52428800

# Local malware scanner (official ClamAV container, loopback-only TCP)
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_CONNECT_TIMEOUT_MS=5000
CLAMAV_SCAN_TIMEOUT_MS=60000

# Local in-process text-to-speech (kokoro-js downloads and caches the model)
TTS_DEFAULT_VOICE=bf_emma
TTS_MODEL_ID=onnx-community/Kokoro-82M-v1.0-ONNX
TTS_MODEL_DTYPE=q8
TTS_MAX_TRANSCRIPT_CHARACTERS=8000
