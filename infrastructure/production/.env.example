# Copy to /home/deploy/best/.env (outside both repositories), chmod 600.
# Use hex secrets so DATABASE_URL needs no extra percent-encoding.
BEST_RELEASE=initial
POSTGRES_PASSWORD=replace-with-64-random-hex-characters
JWT_ACCESS_SECRET=replace-with-an-independent-64-character-secret
AUTH_OTP_HASH_SECRET=replace-with-an-independent-64-character-secret
AUTH_SECRET=replace-with-an-independent-64-character-secret
S3_ACCESS_KEY_ID=best-production
S3_SECRET_ACCESS_KEY=replace-with-an-independent-64-character-secret
